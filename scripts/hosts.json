{
  "schemaVersion": 2,
  "hosts": {
    "claude": {
      "label": "Claude Code",
      "agentDir": ".claude",
      "cluster": "helm",
      "sourceRoot": "root",
      "commandDir": "commands/{cluster}",
      "commandName": "{stage}",
      "commandExt": ".md",
      "slashStyle": "colon",
      "agentSource": "root",
      "rules": null,
      "instructions": { "file": "CLAUDE.md", "mode": "reference-only" },
      "globalAgentDir": "{home}/.claude",
      "checks": [
        { "path": "skills/helm-workflow-router/SKILL.md", "severity": "fail" },
        { "path": "agents/design-reviewer.md", "severity": "fail" },
        { "path": "references/installation/hosts-config.md", "severity": "warn" }
      ],
      "hooks": null,
      "maturity": "p0",
      "status": "ready",
      "cost": "S",
      "note": "canonical commands/ 即宿主布局，零转换"
    },
    "codebuddy": {
      "label": "CodeBuddy",
      "agentDir": ".codebuddy",
      "cluster": "helm",
      "sourceRoot": "host",
      "commandDir": "commands/{cluster}",
      "commandName": "{stage}",
      "commandExt": ".md",
      "slashStyle": "colon",
      "agentSource": "root",
      "rules": null,
      "instructions": null,
      "globalAgentDir": "{home}/.codebuddy",
      "checks": [
        { "path": "commands/helm/apply.md", "severity": "fail" },
        { "path": "skills/helm-workflow-apply/SKILL.md", "severity": "fail" }
      ],
      "hooks": null,
      "maturity": "p1",
      "status": "planned",
      "cost": "S",
      "note": "布局与 claude 同构；v1 已有产物，v2 保留并降为 P1"
    },
    "agents": {
      "label": "ZCode (.agents)",
      "agentDir": ".agents",
      "cluster": "helm",
      "sourceRoot": "host",
      "commandDir": "commands/{cluster}",
      "commandName": "{stage}",
      "commandExt": ".md",
      "slashStyle": "colon",
      "agentSource": "root",
      "rules": null,
      "instructions": { "file": "AGENTS.md", "mode": "reference-only" },
      "globalAgentDir": "{home}/.agents",
      "checks": [
        { "path": "commands/helm/apply.md", "severity": "fail" },
        { "path": "skills/helm-workflow-router/SKILL.md", "severity": "fail" }
      ],
      "hooks": null,
      "maturity": "p0",
      "status": "ready",
      "cost": "S",
      "note": "源布局在 .agents/ 内，必须在 sourceRootFor 里显式指到 .agents（缺陷 14）"
    },
    "cursor": {
      "label": "Cursor",
      "agentDir": ".cursor",
      "cluster": "helm",
      "sourceRoot": "host",
      "commandDir": "commands",
      "commandName": "{cluster}-{stage}",
      "commandExt": ".md",
      "slashStyle": "dash",
      "agentSource": "root",
      "rules": {
        "dir": "rules",
        "ext": ".mdc",
        "filePattern": "{cluster}-{name}{ext}",
        "frontmatter": { "description": "HELM workflow rule", "globs": "", "alwaysApply": true },
        "trigger": "alwaysApply"
      },
      "instructions": null,
      "globalAgentDir": "{home}/.cursor",
      "checks": [
        { "path": "commands/helm-apply.md", "severity": "fail" },
        { "path": "rules/helm-core.mdc", "severity": "warn" }
      ],
      "hooks": null,
      "maturity": "p0",
      "status": "ready",
      "cost": "S"
    },
    "opencode": {
      "label": "OpenCode",
      "agentDir": ".opencode",
      "cluster": "helm",
      "sourceRoot": "host",
      "commandDir": "commands",
      "commandName": "{cluster}-{stage}",
      "commandExt": ".md",
      "slashStyle": "dash",
      "agentSource": "host",
      "rules": null,
      "instructions": null,
      "globalAgentDir": "{xdgConfig}/opencode",
      "globalAgentDirByPlatform": {
        "win32": "{appdata}/opencode",
        "darwin": "{home}/.config/opencode"
      },
      "checks": [
        { "path": "commands/helm-apply.md", "severity": "fail" },
        { "path": "agents/implementer.md", "severity": "warn" }
      ],
      "hooks": null,
      "maturity": "p0",
      "status": "ready",
      "cost": "S",
      "note": "openDir 必须 mkdir -p：v1 的 .opencode 从未被创建（缺陷 14）"
    },
    "codex": {
      "label": "Codex",
      "agentDir": ".codex",
      "cluster": "helm",
      "sourceRoot": "host",
      "commandDir": "workflow",
      "commandName": "{cluster}-{stage}",
      "commandExt": ".md",
      "slashStyle": "natural",
      "agentSource": "root",
      "rules": null,
      "instructions": { "file": "AGENTS.md", "mode": "reference-only" },
      "globalAgentDir": "{home}/.codex",
      "checks": [
        { "path": "workflow/helm-apply.md", "severity": "fail" },
        { "path": "skills/helm-workflow-apply/SKILL.md", "severity": "fail" }
      ],
      "hooks": null,
      "maturity": "p0",
      "status": "ready",
      "cost": "S"
    },
    "copilot-vscode": {
      "label": "GitHub Copilot (VS Code)",
      "agentDir": ".github",
      "cluster": "helm",
      "sourceRoot": "host",
      "commandDir": "prompts",
      "commandName": "{cluster}-{stage}",
      "commandExt": ".prompt.md",
      "slashStyle": "dash",
      "agentSource": "root",
      "rules": {
        "dir": "instructions",
        "ext": ".instructions.md",
        "filePattern": "{cluster}-{name}{ext}",
        "frontmatter": { "applyTo": "**/*" },
        "trigger": "applyTo"
      },
      "instructions": { "file": "copilot-instructions.md", "mode": "reference-only" },
      "globalAgentDir": null,
      "globalAgentDirByPlatform": {
        "win32": "{appdata}/Code/User/prompts",
        "darwin": "{home}/Library/Application Support/Code/User/prompts",
        "linux": "{xdgConfig}/Code/User/prompts"
      },
      "checks": [
        { "path": "prompts/helm-apply.prompt.md", "severity": "fail" },
        { "path": "instructions/helm-core.instructions.md", "severity": "warn" }
      ],
      "hooks": null,
      "maturity": "p0",
      "status": "ready",
      "cost": "M",
      "note": "prompt 文件用 .prompt.md 双扩展；规则用 applyTo 而非 globs"
    },
    "windsurf": {
      "label": "Windsurf",
      "agentDir": ".windsurf",
      "cluster": "helm",
      "sourceRoot": "host",
      "commandDir": "workflows",
      "commandName": "{cluster}-{stage}",
      "commandExt": ".md",
      "slashStyle": "dash",
      "agentSource": "root",
      "rules": {
        "dir": "rules",
        "ext": ".md",
        "filePattern": "{cluster}-{name}{ext}",
        "frontmatter": { "trigger": "manual" },
        "trigger": "manual"
      },
      "instructions": null,
      "globalAgentDir": "{home}/.codeium/windsurf",
      "checks": [
        { "path": "workflows/helm-apply.md", "severity": "fail" },
        { "path": "rules/helm-core.md", "severity": "warn" }
      ],
      "hooks": null,
      "maturity": "p1",
      "status": "planned",
      "cost": "M"
    },
    "cline": {
      "label": "Cline",
      "agentDir": ".clinerules",
      "cluster": "helm",
      "sourceRoot": "host",
      "commandDir": "workflows",
      "commandName": "{cluster}-{stage}",
      "commandExt": ".md",
      "slashStyle": "dash",
      "agentSource": "root",
      "rules": { "dir": ".", "ext": ".md", "filePattern": "{cluster}-{name}{ext}", "frontmatter": {}, "trigger": null },
      "instructions": null,
      "globalAgentDir": "{home}/Documents/Cline/Rules",
      "checks": [
        { "path": "workflows/helm-apply.md", "severity": "fail" },
        { "path": "helm-core.md", "severity": "warn" }
      ],
      "hooks": null,
      "maturity": "p1",
      "status": "planned",
      "cost": "M",
      "note": "规则与命令同目录平铺，靠前缀区分"
    },
    "roo": {
      "label": "Roo Code",
      "agentDir": ".roo",
      "cluster": "helm",
      "sourceRoot": "host",
      "commandDir": "commands",
      "commandName": "{cluster}-{stage}",
      "commandExt": ".md",
      "slashStyle": "dash",
      "agentSource": "root",
      "rules": { "dir": "rules", "ext": ".md", "filePattern": "{cluster}-{name}{ext}", "frontmatter": {}, "trigger": null },
      "instructions": null,
      "globalAgentDir": "{home}/.roo",
      "checks": [
        { "path": "commands/helm-apply.md", "severity": "fail" },
        { "path": "rules/helm-core.md", "severity": "warn" }
      ],
      "hooks": null,
      "maturity": "p1",
      "status": "planned",
      "cost": "S"
    },
    "continue": {
      "label": "Continue",
      "agentDir": ".continue",
      "cluster": "helm",
      "sourceRoot": "host",
      "commandDir": "prompts",
      "commandName": "{cluster}-{stage}",
      "commandExt": ".prompt",
      "slashStyle": "dash",
      "agentSource": "root",
      "rules": {
        "dir": "rules",
        "ext": ".md",
        "filePattern": "{cluster}-{name}{ext}",
        "frontmatter": { "globs": "", "alwaysApply": false },
        "trigger": "globs"
      },
      "instructions": null,
      "globalAgentDir": "{home}/.continue",
      "checks": [
        { "path": "prompts/helm-apply.prompt", "severity": "fail" },
        { "path": "rules/helm-core.md", "severity": "warn" }
      ],
      "hooks": null,
      "maturity": "p1",
      "status": "planned",
      "cost": "M",
      "note": "无扩展点的 .prompt 文件，正文首行即 description"
    },
    "zed": {
      "label": "Zed",
      "agentDir": ".zed",
      "cluster": "helm",
      "sourceRoot": "host",
      "commandDir": "commands",
      "commandName": "{cluster}-{stage}",
      "commandExt": ".md",
      "slashStyle": "natural",
      "agentSource": "root",
      "rules": { "dir": ".", "ext": ".rules", "filePattern": "{cluster}{ext}", "frontmatter": {}, "trigger": null },
      "instructions": null,
      "globalAgentDir": "{home}/.config/zed",
      "checks": [{ "path": "commands/helm-apply.md", "severity": "fail" }],
      "hooks": null,
      "maturity": "p2",
      "status": "planned",
      "cost": "L",
      "note": "无原生 slash 命令，靠 .rules 注入 + 自然语言触发"
    },
    "jetbrains-junie": {
      "label": "JetBrains AI / Junie",
      "agentDir": ".junie",
      "cluster": "helm",
      "sourceRoot": "host",
      "commandDir": "commands",
      "commandName": "{cluster}-{stage}",
      "commandExt": ".md",
      "slashStyle": "dash",
      "agentSource": "root",
      "rules": { "dir": ".", "ext": ".md", "filePattern": "{cluster}-guidelines{ext}", "frontmatter": {}, "trigger": null },
      "instructions": { "file": "guidelines.md", "mode": "reference-only" },
      "globalAgentDir": "{home}/.junie",
      "checks": [{ "path": "commands/helm-apply.md", "severity": "fail" }],
      "hooks": null,
      "maturity": "p2",
      "status": "planned",
      "cost": "L"
    },
    "aider": {
      "label": "Aider",
      "agentDir": ".aider",
      "cluster": "helm",
      "sourceRoot": "host",
      "commandDir": ".",
      "commandName": "{cluster}-{stage}",
      "commandExt": ".md",
      "slashStyle": "natural",
      "agentSource": "root",
      "rules": { "dir": ".", "ext": ".md", "filePattern": "CONVENTIONS{ext}", "frontmatter": {}, "trigger": null },
      "instructions": { "file": "CONVENTIONS.md", "mode": "reference-only" },
      "globalAgentDir": "{home}/.aider",
      "checks": [{ "path": "helm-apply.md", "severity": "fail" }],
      "hooks": null,
      "maturity": "p2",
      "status": "planned",
      "cost": "L",
      "note": "无命令概念，只能靠 --read 注入；成本最高、收益最低"
    }
  }
}
